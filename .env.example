# ==========================================
# HR Cold Mailer Configuration
# ==========================================

# Gmail address used for sending emails via smtp.gmail.com
GMAIL_ADDRESS=danishsjain@gmail.com

# 16-character Google App Password (spaces optional)
# Generate from: Google Account -> Security -> 2-Step Verification -> App Passwords
# WARNING: Do NOT use your regular Google account password.
GMAIL_APP_PASSWORD=your_16_character_app_password_here

# Flask secret key (optional, auto-generated if left blank)
FLASK_SECRET_KEY=hr-cold-mailer-secret-key-change-in-production

